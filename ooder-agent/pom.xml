<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/>
    </parent>

    <groupId>net.ooder</groupId>
    <artifactId>ooder-agent</artifactId>
    <version>3.0.2</version>
    <packaging>jar</packaging>

    <name>ooder-agent</name>
    <description>ooderAgent - AI Agent核心框架 (Large) 3.0.2版本 - Small+向量存储+云存储+全文搜索+RAG+知识库</description>

    <url>https://gitee.com/ooderCN/super-Agent</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>onecode</id>
            <name>onecode Team</name>
            <email>onecode@ooder.cn</email>
            <organization>ooder</organization>
            <organizationUrl>https://gitee.com/ooderCN</organizationUrl>
        </developer>
    </developers>

    <properties>
        <java.version>21</java.version>
        <ooder.sdk.version>3.0.2</ooder.sdk.version>
        <fastjson2.version>2.0.57</fastjson2.version>
        <commons-collections4.version>4.4</commons-collections4.version>
        <commons-io.version>2.18.0</commons-io.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.enablePreview>true</maven.compiler.enablePreview>
    </properties>

    <repositories>
        <repository>
            <id>mvn-central</id>
            <name>Maven Central</name>
            <url>https://repo1.maven.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>mvn-central</id>
            <name>Maven Central</name>
            <url>https://repo1.maven.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <dependencies>
        <!-- ========== Spring Boot 基础 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-community-dialects</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-freemarker</artifactId>
        </dependency>

        <!-- ========== Small: WebSocket 支持 ========== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- ========== 核心SDK ========== -->
        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>agent-sdk-core</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skill-common</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>scene-engine</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <!-- ========== Small: LLM 集成 ========== -->
        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>llm-sdk</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skill-llm-chat</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skill-llm-base</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <!-- ========== Large: 向量存储 ========== -->
        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skill-local-vector-store</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <!-- ========== Large: 全文搜索 ========== -->
        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>ooder-index-web</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <!-- ========== Large: 云存储 ========== -->
        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skill-vfs-base</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <!-- ========== Large: RAG + 知识库 ========== -->
        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skill-rag</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skill-knowledge</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <!-- ========== Large: 知识库 (TODO: skill-knowledge-base:3.0.2 待发布后添加) ========== -->

        <!-- ========== 组织管理 ========== -->
        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skill-org</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skill-org-base</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <!-- ========== 技能框架 ========== -->
        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skill-discovery</artifactId>
            <version>${ooder.sdk.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skill-hotplug-starter</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skills-framework</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>ooder-bpm-web</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skill-menu</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skill-auth</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>net.ooder</groupId>
            <artifactId>skill-audit</artifactId>
            <version>${ooder.sdk.version}</version>
        </dependency>

        <!-- ========== API 文档 ========== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.6</version>
        </dependency>

        <!-- ========== Small: MySQL 数据库 ========== -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ========== Large: 增强工具 ========== -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>${commons-collections4.version}</version>
        </dependency>

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons-io.version}</version>
        </dependency>

        <!-- ========== 工具库 ========== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>${fastjson2.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mvel</groupId>
            <artifactId>mvel2</artifactId>
            <version>2.5.0.Final</version>
        </dependency>
        
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.49.1.0</version>
        </dependency>
        
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>6.7.0.202309050840-r</version>
        </dependency>
        
        <dependency>
            <groupId>org.kohsuke</groupId>
            <artifactId>github-api</artifactId>
            <version>1.316</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <parameters>true</parameters>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <version>0.10.6</version>
                <configuration>
                    <buildArgs>
                        <buildArg>--enable-preview</buildArg>
                        <buildArg>--no-fallback</buildArg>
                        <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                        <buildArg>--allow-incomplete-classpath</buildArg>
                        <buildArg>--report-unsupported-elements-at-runtime</buildArg>
                    </buildArgs>
                    <quickBuild>true</quickBuild>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                        --add-opens java.base/java.io=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                        --enable-preview
                    </jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.6</version>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <buildArgs>
                                <buildArg>--enable-preview</buildArg>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <buildArg>--allow-incomplete-classpath</buildArg>
                                <buildArg>--report-unsupported-elements-at-runtime</buildArg>
                            </buildArgs>
                            <quickBuild>true</quickBuild>
                            <mainClass>net.ooder.agent.AgentApplication</mainClass>
                            <imageName>ooder-agent-native</imageName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
