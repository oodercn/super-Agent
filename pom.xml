<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.ooder</groupId>
    <artifactId>super-agent-parent</artifactId>
    <version>3.0.2</version>
    <packaging>pom</packaging>
    <name>Super Agent Parent</name>
    <description>Parent POM for ooderAgent 3.0.2 Modules</description>

    <url>https://gitee.com/ooderCN/super-Agent</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>onecode</id>
            <name>onecode Team</name>
            <email>onecode@ooder.cn</email>
            <organization>ooder</organization>
            <organizationUrl>https://gitee.com/ooderCN</organizationUrl>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://gitee.com/ooderCN/super-Agent.git</connection>
        <developerConnection>scm:git:https://gitee.com/ooderCN/super-Agent.git</developerConnection>
        <url>https://gitee.com/ooderCN/super-Agent</url>
    </scm>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <ooder.sdk.version>3.0.2</ooder.sdk.version>
        <fastjson2.version>2.0.57</fastjson2.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.enablePreview>true</maven.compiler.enablePreview>
        <milvus-sdk.version>2.4.1</milvus-sdk.version>
        <commons-lang3.version>3.17.0</commons-lang3.version>
        <commons-collections4.version>4.4</commons-collections4.version>
        <commons-io.version>2.18.0</commons-io.version>
    </properties>

    <modules>
        <module>ooder-agent</module>
        <module>ooder-nexus</module>
        <module>ooder-nexus-enterprise</module>
    </modules>

    <repositories>
        <repository>
            <id>mvn-central</id>
            <name>Maven Central</name>
            <url>https://repo1.maven.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>mvn-central</id>
            <name>Maven Central</name>
            <url>https://repo1.maven.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>agent-sdk-core</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-common</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>scene-engine</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>llm-sdk</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-discovery</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-hotplug-starter</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skills-framework</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>ooder-bpm-web</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-tenant</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-org</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-org-base</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-local-vector-store</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>ooder-index-web</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-vfs-base</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-rag</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-knowledge</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-knowledge-base</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-knowledge-platform</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-security</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-menu</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-auth</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-audit</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-notification</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-messaging</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-context</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-llm-chat</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-llm-conversation</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ooder</groupId>
                <artifactId>skill-llm-base</artifactId>
                <version>${ooder.sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>1.18.30</version>
            </dependency>
            <dependency>
                <groupId>io.milvus</groupId>
                <artifactId>milvus-sdk-java</artifactId>
                <version>${milvus-sdk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <compilerArgs>
                        <arg>--enable-preview</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
